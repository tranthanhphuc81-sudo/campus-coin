flowchart TB
  dev["Dev push / Pull Request"] --> CI
  subgraph CI["GitHub Actions – CI (mỗi PR)"]
    direction LR
    c1["npm ci"] --> c2["ESLint + tsc --noEmit"] --> c3["Unit + Integration test<br/>Vitest · Supertest · MySQL service"] --> c4["npm audit"]
