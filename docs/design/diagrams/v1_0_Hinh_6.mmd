flowchart TB
  REQ["HTTP Request"] --> MW
  subgraph MW["Middleware Pipeline"]
    direction LR
    h["helmet<br/>security headers"] --> c["cors<br/>allowlist"] --> rl["rate-limit<br/>bộ nhớ trong"] --> lg["requestId + pino logger"] --> au["authenticate<br/>JWT verify"] --> az["authorize<br/>RBAC + ownership"] --> v["validate<br/>Zod schema"]
  end
  MW --> RT["Routes /api/v1/*"] --> CT["Controllers<br/>(mỏng – map HTTP ↔ DTO)"] --> SV["Services<br/>(nghiệp vụ, transaction DB)"]
  SV --> RP["Repositories<br/>(luôn lọc theo user_id)"] --> PC["Prisma Client"] --> DB[("MySQL")]
  SV --> AIA["AI Adapter"]
  SV --> EV["Domain Events nội bộ<br/>(EventEmitter: transaction.created ...)"]
  EV --> H1["BudgetAlertHandler"]
  EV --> H2["AnomalyDetector"]
  SCH["Scheduler node-cron<br/>định kỳ · nhận định · dọn dẹp"] --> SV
  SV -.-> MOD
  subgraph MOD["Modules nghiệp vụ"]
    direction LR
    m1["auth"] --- m2["users"] --- m3["categories"] --- m4["transactions"] --- m5["imports"]
    m6["budgets"] --- m7["reports"] --- m8["insights"] --- m9["tips"] --- m10["notifications"]
    m11["bookmarks"] --- m12["admin"] --- m13["ai"] --- m14["activity"]
  end
