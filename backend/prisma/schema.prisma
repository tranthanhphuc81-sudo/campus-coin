// =============================================================================
// schema.prisma
// CampusCoin data model: the 18 tables of docs/spec/06 §6.3 (MySQL 8.4, InnoDB, utf8mb4).
// Conventions:
//   - camelCase fields in Prisma, snake_case columns/tables in MySQL (@map / @@map).
//   - Money: Decimal(14,2). Timestamps: DATETIME(3) in UTC. txn_date / month / period:
//     DATE in the user's local timezone (month/period = first day of the month).
//   - UUID v7 (CHAR(36)) for users, transactions, import_batches, refresh_tokens;
//     auto-increment INT/BIGINT for lookup and log tables.
//   - onDelete: RESTRICT for financial data, CASCADE for dependent data (tokens,
//     notifications, …) – spec §6.1.
//   - CHECK constraints and the utf8mb4_0900_ai_ci collation are NOT expressible in
//     Prisma; they are added by hand in the migration SQL (see prisma/README.md).
// Spec: docs/spec/06 §6.1–§6.4
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums (values match docs/spec/06 exactly; mirrored in shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum Role {
  student
  admin
}

enum UserStatus {
  pending
  active
  disabled
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  manual
  recurring
  csv_import
}

enum CategorySource {
  user
  ai_accepted
  ai_overridden
  rule
  import
}

enum HistoryAction {
  create
  update
  delete
  restore
}

enum RecurringFrequency {
  weekly
  monthly
  yearly
}

enum InsightGenerator {
  llm
  template
}

enum InsightStatus {
  queued
  processing
  completed
  failed
}

enum TipRuleType {
  over_budget
  above_average
  small_frequent
  subscriptions
  savings_gap
  weekend_spike
  general
}

enum UserTipStatus {
  active
  pinned
  dismissed
}

enum NotificationType {
  budget_near
  budget_exceeded
  insight_ready
  anomaly
  duplicate
  system
}

enum BookmarkTargetType {
  tip
  insight
  report
}

enum ImportBatchStatus {
  uploaded
  parsing
  previewed
  committed
  failed
  expired
}

enum RecentActivityAction {
  viewed
  edited
}

enum AnnouncementLevel {
  info
  warning
}

// ---------------------------------------------------------------------------
// Authentication & sessions
// ---------------------------------------------------------------------------

/// Account of a student or an admin (Bảng 26). Soft-deleted via deletedAt (30-day grace period).
model User {
  id                       String     @id @default(uuid(7)) @db.Char(36)
  /// Login email, always stored lower-case.
  email                    String     @unique @db.VarChar(254)
  /// Argon2id encoded hash (includes salt and parameters).
  passwordHash             String     @map("password_hash") @db.VarChar(255)
  fullName                 String     @map("full_name") @db.VarChar(100)
  role                     Role       @default(student)
  status                   UserStatus @default(pending)
  academicYear             String?    @map("academic_year") @db.VarChar(20)
  /// Baseline monthly allowance; CHECK >= 0 in migration SQL.
  monthlyAllowanceBaseline Decimal?   @map("monthly_allowance_baseline") @db.Decimal(14, 2)
  /// Monthly savings goal; CHECK >= 0 in migration SQL.
  monthlySavingsGoal       Decimal?   @map("monthly_savings_goal") @db.Decimal(14, 2)
  /// ISO 4217 currency code.
  currency                 String     @default("USD") @db.Char(3)
  /// IANA timezone used to compute local dates (txn_date, month).
  timezone                 String     @default("Asia/Ho_Chi_Minh") @db.VarChar(40)
  /// UI preferences: { theme, fontScale, locale }.
  preferences              Json?
  /// Consent to send anonymised data to the LLM (default off).
  aiOptIn                  Boolean    @default(false) @map("ai_opt_in")
  emailVerifiedAt          DateTime?  @map("email_verified_at") @db.DateTime(3)
  /// Consecutive failed logins (reset on success).
  failedLoginCount         Int        @default(0) @map("failed_login_count") @db.UnsignedTinyInt
  /// Temporary login lock-out end.
  lockedUntil              DateTime?  @map("locked_until") @db.DateTime(3)
  /// Admin TOTP secret, AES-256-GCM encrypted.
  mfaSecretEnc             Bytes?     @map("mfa_secret_enc") @db.VarBinary(255)
  /// Admin MFA recovery codes: JSON array of hashes (never plain codes). Not in spec table; added in P02.
  mfaRecoveryCodes         Json?      @map("mfa_recovery_codes")
  lastLoginAt              DateTime?  @map("last_login_at") @db.DateTime(3)
  /// Account deletion requested at (hard delete after the 30-day grace period).
  deletedAt                DateTime?  @map("deleted_at") @db.DateTime(3)
  createdAt                DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  categories       Category[]
  transactions     Transaction[]
  recurringRules   RecurringRule[]
  budgets          Budget[]
  insights         Insight[]
  tipTemplates     TipTemplate[]
  userTips         UserTip[]
  notifications    Notification[]
  bookmarks        Bookmark[]
  aiCategoryRules  AiCategoryRule[]
  importBatches    ImportBatch[]
  recentActivities RecentActivity[]
  announcements    Announcement[]

  @@map("users")
}

/// Refresh-token session (Bảng 27). Only the SHA-256 hash of the token is stored.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  /// SHA-256 (hex) of the refresh token.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  /// Rotation family: reuse of a revoked token revokes the whole family.
  familyId     String    @map("family_id") @db.Char(36)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  /// HMAC-SHA256 of the client IP (privacy).
  ipHash       String?   @map("ip_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  /// Id of the token that replaced this one on rotation.
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One-time token for email verification / password reset (Bảng 28). Hash only.
model AuthToken {
  id        BigInt           @id @default(autoincrement())
  userId    String           @map("user_id") @db.Char(36)
  purpose   AuthTokenPurpose
  /// SHA-256 (hex) of the emailed token.
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  /// 24 h for verify_email, 30 min for reset_password.
  expiresAt DateTime         @map("expires_at") @db.DateTime(3)
  /// Set when consumed (single use).
  usedAt    DateTime?        @map("used_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Core finance
// ---------------------------------------------------------------------------

/// Income/expense category (Bảng 29). userId NULL = system default category.
model Category {
  id        Int             @id @default(autoincrement())
  /// Owner; NULL for system defaults.
  userId    String?         @map("user_id") @db.Char(36)
  /// The spec defines owner_key as a GENERATED column COALESCE(user_id,'SYSTEM') so the
  /// UNIQUE(owner_key, type, name) also works for NULL user_id. Prisma cannot model generated
  /// columns, so this is a plain column the service MUST set to `userId ?? 'SYSTEM'`;
  /// a CHECK constraint in the migration SQL enforces the same invariant in the DB.
  ownerKey  String          @map("owner_key") @db.VarChar(36)
  name      String          @db.VarChar(50)
  type      TransactionType
  /// Bootstrap Icons name, e.g. "cup-hot".
  icon      String?         @db.VarChar(40)
  /// HEX colour "#RRGGBB".
  color     String?         @db.Char(7)
  isDefault Boolean         @default(false) @map("is_default")
  /// FALSE = archived/hidden from pickers; old transactions keep it (BR-CA-03/05).
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  /// onUpdate Restrict (not Prisma's default Cascade): MySQL only allows the owner_key CHECK when this FK has no cascading action.
  user            User?            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions    Transaction[]
  recurringRules  RecurringRule[]
  budgets         Budget[]
  aiCategoryRules AiCategoryRule[]

  @@unique([ownerKey, type, name])
  @@index([userId])
  @@map("categories")
}

/// Income/expense transaction (Bảng 30). Soft-deleted; optimistic locking via version.
model Transaction {
  id                    String            @id @default(uuid(7)) @db.Char(36)
  userId                String            @map("user_id") @db.Char(36)
  categoryId            Int               @map("category_id")
  type                  TransactionType
  /// Always positive (CHECK > 0 in migration SQL); type gives the sign (BR-TX-01).
  amount                Decimal           @db.Decimal(14, 2)
  /// Currency at the time of recording.
  currency              String            @db.Char(3)
  /// Free text, stored as plain text (BR-TX-04).
  description           String?           @db.VarChar(255)
  /// Normalised description used by AI rules and duplicate detection.
  merchantKey           String?           @map("merchant_key") @db.VarChar(100)
  /// Local date in the user's timezone.
  txnDate               DateTime          @map("txn_date") @db.Date
  source                TransactionSource @default(manual)
  recurringRuleId       Int?              @map("recurring_rule_id")
  /// Period generated by the recurring rule, e.g. "2026-09"; UNIQUE with recurringRuleId.
  recurringPeriod       String?           @map("recurring_period") @db.Char(10)
  importBatchId         String?           @map("import_batch_id") @db.Char(36)
  /// Category suggested by AI (no FK by spec: kept for AI quality stats).
  aiSuggestedCategoryId Int?              @map("ai_suggested_category_id")
  /// Suggestion confidence 0–1 (CHECK in migration SQL).
  aiConfidence          Decimal?          @map("ai_confidence") @db.Decimal(4, 3)
  /// How the category was chosen – measures AI quality.
  categorySource        CategorySource    @default(user) @map("category_source")
  isAnomaly             Boolean           @default(false) @map("is_anomaly")
  isPossibleDuplicate   Boolean           @default(false) @map("is_possible_duplicate")
  /// Optimistic lock counter (BR-TX-05).
  version               Int               @default(1)
  /// Soft delete; purged after 30 days (BR-TX-07).
  deletedAt             DateTime?         @map("deleted_at") @db.DateTime(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Deleting a rule keeps the transactions it generated (§5.4.2).
  recurringRule    RecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  importBatch      ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  recentActivities RecentActivity[]

  @@unique([recurringRuleId, recurringPeriod])
  @@index([userId, deletedAt, txnDate(sort: Desc)])
  @@index([userId, categoryId, txnDate])
  @@index([userId, type, txnDate])
  @@index([userId, merchantKey])
  @@index([merchantKey])
  @@map("transactions")
}

/// Append-only change log of transactions (Bảng 31). No FKs so history survives purges.
model TransactionHistory {
  id            BigInt        @id @default(autoincrement())
  transactionId String        @map("transaction_id") @db.Char(36)
  userId        String        @map("user_id") @db.Char(36)
  action        HistoryAction
  /// Full transaction state after the change.
  snapshot      Json
  /// Changed fields with their previous values.
  changedFields Json?         @map("changed_fields")
  /// User id of the actor, or "SYSTEM".
  changedBy     String        @map("changed_by") @db.Char(36)
  changedAt     DateTime      @default(now()) @map("changed_at") @db.DateTime(3)

  @@index([transactionId, changedAt])
  @@index([userId])
  @@map("transaction_history")
}

/// Rule that generates recurring transactions (Bảng 32).
model RecurringRule {
  id            Int                @id @default(autoincrement())
  userId        String             @map("user_id") @db.Char(36)
  categoryId    Int                @map("category_id")
  type          TransactionType
  /// CHECK > 0 in migration SQL.
  amount        Decimal            @db.Decimal(14, 2)
  description   String?            @db.VarChar(255)
  frequency     RecurringFrequency
  /// Every N periods; CHECK 1–12 in migration SQL.
  intervalCount Int                @default(1) @map("interval_count") @db.TinyInt
  /// 1–31 for monthly/yearly rules (29–31 fall back to the month's last day).
  dayOfMonth    Int?               @map("day_of_month") @db.TinyInt
  /// ISO weekday 1–7 for weekly rules.
  dayOfWeek     Int?               @map("day_of_week") @db.TinyInt
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime?          @map("end_date") @db.Date
  /// Next local date the daily job will generate a transaction.
  nextRunDate   DateTime           @map("next_run_date") @db.Date
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([isActive, nextRunDate])
  @@index([userId])
  @@map("recurring_rules")
}

/// Monthly budget per expense category (Bảng 33).
model Budget {
  id                Int      @id @default(autoincrement())
  userId            String   @map("user_id") @db.Char(36)
  /// Must be an expense category (checked by the service).
  categoryId        Int      @map("category_id")
  /// First day of the budget month.
  month             DateTime @db.Date
  /// CHECK > 0 in migration SQL.
  limitAmount       Decimal  @map("limit_amount") @db.Decimal(14, 2)
  /// Alert when spending reaches this %; CHECK 50–100 in migration SQL.
  alertThresholdPct Int      @default(80) @map("alert_threshold_pct") @db.TinyInt
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, month])
  @@index([categoryId])
  @@map("budgets")
}

// ---------------------------------------------------------------------------
// AI, insights & tips
// ---------------------------------------------------------------------------

/// Monthly AI/template insight (Bảng 34).
model Insight {
  id              Int              @id @default(autoincrement())
  userId          String           @map("user_id") @db.Char(36)
  /// First day of the analysed month.
  month           DateTime         @db.Date
  summaryText     String?          @map("summary_text") @db.Text
  tipText         String?          @map("tip_text") @db.Text
  /// Unusual growth patterns detected.
  flaggedPatterns Json?            @map("flagged_patterns")
  /// Input numbers, kept to reproduce/verify the insight.
  statsSnapshot   Json?            @map("stats_snapshot")
  generator       InsightGenerator
  model           String?          @db.VarChar(60)
  promptVersion   String?          @map("prompt_version") @db.VarChar(20)
  status          InsightStatus
  /// Regenerations used; CHECK <= 3 in migration SQL.
  regenerateCount Int              @default(0) @map("regenerate_count") @db.UnsignedTinyInt
  generatedAt     DateTime?        @map("generated_at") @db.DateTime(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("insights")
}

/// Admin-managed tip template (Bảng 35). Text uses {category}, {amount}, {percent}.
model TipTemplate {
  id        Int         @id @default(autoincrement())
  /// Stable code, e.g. R1_OVER_BUDGET_1.
  code      String      @unique @db.VarChar(40)
  ruleType  TipRuleType @map("rule_type")
  titleTpl  String      @map("title_tpl") @db.VarChar(150)
  bodyTpl   String      @map("body_tpl") @db.VarChar(500)
  /// Spec default is 'vi'; 'en' here because the UI language is English (CLAUDE.md rule 1).
  locale    String      @default("en") @db.VarChar(5)
  isActive  Boolean     @default(true) @map("is_active")
  /// Admin author; NULL for seeded system templates.
  createdBy String?     @map("created_by") @db.Char(36)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  author   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  userTips UserTip[]

  @@index([ruleType, isActive])
  @@map("tip_templates")
}

/// Tip generated for a user from a template (Bảng 36).
model UserTip {
  id             BigInt        @id @default(autoincrement())
  userId         String        @map("user_id") @db.Char(36)
  templateId     Int           @map("template_id")
  /// Related category (no FK by spec); NULL for general tips.
  categoryId     Int?          @map("category_id")
  /// First day of the month the tip applies to.
  period         DateTime      @db.Date
  renderedTitle  String        @map("rendered_title") @db.VarChar(200)
  renderedBody   String        @map("rendered_body") @db.VarChar(600)
  /// Estimated potential saving.
  impactAmount   Decimal       @map("impact_amount") @db.Decimal(14, 2)
  /// Ranking score = impact × confidence × recency.
  score          Decimal       @db.Decimal(12, 4)
  status         UserTipStatus @default(active)
  /// Hidden until this local date after dismiss (30 days).
  dismissedUntil DateTime?     @map("dismissed_until") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template TipTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([userId, templateId, categoryId, period])
  @@index([score])
  @@index([templateId])
  @@map("user_tips")
}

/// Merchant → category rule learned from the user's corrections (AI tier 1).
model AiCategoryRule {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.Char(36)
  merchantKey String   @map("merchant_key") @db.VarChar(100)
  categoryId  Int      @map("category_id")
  /// Category the user corrected to on the FIRST of two consecutive corrections (D4); a second
  /// identical correction replaces `categoryId` with this value. No FK (same no-FK precedent as
  /// `transactions.ai_suggested_category_id`) — a stale pointer to a deleted category is harmless,
  /// it is only ever compared against, never joined.
  pendingCategoryId Int? @map("pending_category_id")
  hitCount    Int      @default(1) @map("hit_count") @db.UnsignedInt
  lastUsedAt  DateTime @default(now()) @map("last_used_at") @db.DateTime(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cascade: a rule pointing to a deleted category is useless.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([categoryId])
  @@map("ai_category_rules")
}

// ---------------------------------------------------------------------------
// Interaction & system
// ---------------------------------------------------------------------------

/// In-app notification. dedupeKey prevents duplicate alerts (e.g. budget:<id>:80).
model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    String           @map("user_id") @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String?          @db.VarChar(500)
  payload   Json?
  dedupeKey String           @map("dedupe_key") @db.VarChar(100)
  readAt    DateTime?        @map("read_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Bookmark + note on a tip, insight or report.
model Bookmark {
  id         Int                @id @default(autoincrement())
  userId     String             @map("user_id") @db.Char(36)
  targetType BookmarkTargetType @map("target_type")
  /// Id/key of the target (tip id, insight month, report query key). Widened from VarChar(64) to
  /// VarChar(255) (P14 stage 2b) — a report bookmark's targetRef is a filter query string
  /// (e.g. "by-category?from=...&to=...&categoryId=3,17,42") that can easily exceed 64 chars.
  targetRef  String             @map("target_ref") @db.VarChar(255)
  note       String?            @db.VarChar(500)
  createdAt  DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetRef])
  @@map("bookmarks")
}

/// CSV import batch. The row preview itself lives in Redis (24 h), not in MySQL.
model ImportBatch {
  id               String            @id @default(uuid(7)) @db.Char(36)
  userId           String            @map("user_id") @db.Char(36)
  originalFilename String            @map("original_filename") @db.VarChar(255)
  /// SHA-256 of the file; UNIQUE per user blocks re-importing the same file.
  fileSha256       String            @map("file_sha256") @db.Char(64)
  status           ImportBatchStatus @default(uploaded)
  totalRows        Int               @default(0) @map("total_rows") @db.UnsignedInt
  validRows        Int               @default(0) @map("valid_rows") @db.UnsignedInt
  committedRows    Int               @default(0) @map("committed_rows") @db.UnsignedInt
  /// Per-row validation errors.
  errorReport      Json?             @map("error_report")
  committedAt      DateTime?         @map("committed_at") @db.DateTime(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, fileSha256])
  @@map("import_batches")
}

/// Recently viewed/edited transactions (the service keeps 20 rows per user).
model RecentActivity {
  id            BigInt               @id @default(autoincrement())
  userId        String               @map("user_id") @db.Char(36)
  transactionId String               @map("transaction_id") @db.Char(36)
  action        RecentActivityAction
  occurredAt    DateTime             @default(now()) @map("occurred_at") @db.DateTime(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([transactionId])
  @@map("recent_activity")
}

/// System-wide announcement shown in a banner between startsAt and endsAt.
model Announcement {
  id        Int               @id @default(autoincrement())
  title     String            @db.VarChar(150)
  body      String            @db.VarChar(1000)
  level     AnnouncementLevel @default(info)
  startsAt  DateTime          @map("starts_at") @db.DateTime(3)
  endsAt    DateTime?         @map("ends_at") @db.DateTime(3)
  isActive  Boolean           @default(true) @map("is_active")
  /// Admin author; NULL if that admin was deleted.
  createdBy String?           @map("created_by") @db.Char(36)
  createdAt DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  author User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@index([createdBy])
  @@map("announcements")
}

/// Immutable audit log (INSERT/SELECT only). No FK: entries outlive (anonymised) users.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  /// Acting user id, or NULL for system jobs.
  actorId    String?  @map("actor_id") @db.Char(36)
  actorRole  String?  @map("actor_role") @db.VarChar(20)
  /// Dotted action code, e.g. "auth.login.failed".
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// HMAC-SHA256 of the client IP.
  ipHash     String?  @map("ip_hash") @db.Char(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
