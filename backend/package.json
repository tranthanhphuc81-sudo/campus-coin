{
  "name": "@campuscoin/backend",
  "version": "0.1.0",
  "private": true,
  "description": "CampusCoin REST API (Express 5) and background worker (BullMQ).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../.env src/server.ts",
    "worker": "tsx watch --clear-screen=false --env-file-if-exists=../.env src/worker.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../.env prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx --env-file-if-exists=../.env src/scripts/create-admin.ts",
    "ai:eval": "tsx --env-file-if-exists=../.env tests/eval/ai-eval.ts",
    "docs:openapi": "tsx --env-file-if-exists=../.env src/openapi/generate.ts",
    "db:export": "tsx --env-file-if-exists=../.env src/scripts/db-export.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@campuscoin/shared": "^0.1.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^11.1.0",
    "@types/archiver": "^8.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pdfmake": "^0.3.11",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
