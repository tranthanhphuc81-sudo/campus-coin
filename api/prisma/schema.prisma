generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    STUDENT
    ADMIN
}

enum AuthTokenPurpose {
    VERIFY_EMAIL
    RESET_PASSWORD
}

enum CategoryType {
    INCOME
    EXPENSE
}

enum TransactionType {
    INCOME
    EXPENSE
}

enum TransactionSource {
    MANUAL
    RECURRING
    CSV_IMPORT
}

enum RecurringFrequency {
    WEEKLY
    MONTHLY
    YEARLY
}

enum ImportBatchStatus {
    UPLOADED
    PARSING
    PREVIEWED
    COMMITTED
    FAILED
    EXPIRED
}

enum NotificationType {
    BUDGET_NEAR
    BUDGET_EXCEEDED
    INSIGHT_READY
    ANOMALY
    DUPLICATE
    SYSTEM
}

enum TransactionHistoryAction {
    CREATE
    UPDATE
    DELETE
    RESTORE
}

model User {
    id              String               @id @db.Char(36)
    fullName        String               @map("full_name") @db.VarChar(120)
    email           String               @unique @db.VarChar(254)
    passwordHash    String               @map("password_hash") @db.VarChar(255)
    role            UserRole             @default(STUDENT)
    aiOptIn         Boolean              @default(false) @map("ai_opt_in")
    emailVerifiedAt DateTime?            @map("email_verified_at")
    deletedAt       DateTime?            @map("deleted_at")
    createdAt       DateTime             @default(now()) @map("created_at")
    updatedAt       DateTime             @updatedAt @map("updated_at")
    refreshTokens   RefreshToken[]
    authTokens      AuthToken[]
    categories      Category[]
    transactions    Transaction[]
    recurringRules  RecurringRule[]
    budgets         Budget[]
    notifications   Notification[]
    importBatches   ImportBatch[]
    idempotencyKeys IdempotencyKey[]
    historyEntries  TransactionHistory[]
    aiCategoryRules AiCategoryRule[]
    aiUsageDaily    AiUsageDaily[]

    @@map("users")
}

model RefreshToken {
    id        String    @id @db.Char(36)
    userId    String    @map("user_id") @db.Char(36)
    expiresAt DateTime  @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    createdAt DateTime  @default(now()) @map("created_at")
    userAgent String?   @map("user_agent") @db.VarChar(255)
    ipAddress String?   @map("ip_address") @db.VarChar(64)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], map: "idx_refresh_tokens_user_id")
    @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
    @@map("refresh_tokens")
}

model AuthToken {
    id        BigInt           @id @default(autoincrement())
    userId    String           @map("user_id") @db.Char(36)
    purpose   AuthTokenPurpose
    tokenHash String           @unique @map("token_hash") @db.Char(64)
    expiresAt DateTime         @map("expires_at")
    usedAt    DateTime?        @map("used_at")
    createdAt DateTime         @default(now()) @map("created_at")
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([expiresAt], map: "idx_auth_tokens_expires_at")
    @@map("auth_tokens")
}

model Category {
    id              Int              @id @default(autoincrement())
    userId          String?          @map("user_id") @db.Char(36)
    name            String           @db.VarChar(50)
    type            CategoryType
    icon            String?          @db.VarChar(40)
    color           String?          @db.Char(7)
    isDefault       Boolean          @default(false) @map("is_default")
    isActive        Boolean          @default(true) @map("is_active")
    sortOrder       Int              @default(0) @map("sort_order")
    createdAt       DateTime         @default(now()) @map("created_at")
    updatedAt       DateTime         @updatedAt @map("updated_at")
    user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions    Transaction[]
    recurringRules  RecurringRule[]
    budgets         Budget[]
    aiCategoryRules AiCategoryRule[]
    importRows      ImportRow[]

    @@unique([userId, type, name], map: "uq_categories_user_type_name")
    @@index([userId, type, isActive], map: "idx_categories_user_type_active")
    @@map("categories")
}

model Transaction {
    id              String               @id @db.Char(36)
    userId          String               @map("user_id") @db.Char(36)
    categoryId      Int                  @map("category_id")
    type            TransactionType
    amount          Decimal              @db.Decimal(14, 2)
    description     String?              @db.VarChar(255)
    source          TransactionSource    @default(MANUAL)
    recurringRuleId Int?                 @map("recurring_rule_id")
    recurringPeriod String?              @map("recurring_period") @db.Char(10)
    importBatchId   String?              @map("import_batch_id") @db.Char(36)
    deletedAt       DateTime?            @map("deleted_at")
    txnDate         DateTime             @map("txn_date") @db.Date
    createdAt       DateTime             @default(now()) @map("created_at")
    updatedAt       DateTime             @updatedAt @map("updated_at")
    user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
    category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    recurringRule   RecurringRule?       @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
    importBatch     ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
    historyEntries  TransactionHistory[]

    @@unique([recurringRuleId, recurringPeriod], map: "uq_transactions_recurring_period")
    @@index([userId, txnDate], map: "idx_transactions_user_date")
    @@index([userId, categoryId, txnDate], map: "idx_transactions_user_category_date")
    @@index([deletedAt], map: "idx_transactions_deleted_at")
    @@map("transactions")
}

model RecurringRule {
    id            Int                @id @default(autoincrement())
    userId        String             @map("user_id") @db.Char(36)
    categoryId    Int                @map("category_id")
    type          TransactionType
    amount        Decimal            @db.Decimal(14, 2)
    description   String?            @db.VarChar(255)
    frequency     RecurringFrequency
    intervalCount Int                @default(1) @map("interval_count") @db.TinyInt
    dayOfMonth    Int?               @map("day_of_month") @db.TinyInt
    dayOfWeek     Int?               @map("day_of_week") @db.TinyInt
    startDate     DateTime           @map("start_date") @db.Date
    endDate       DateTime?          @map("end_date") @db.Date
    nextRunDate   DateTime           @map("next_run_date") @db.Date
    isActive      Boolean            @default(true) @map("is_active")
    createdAt     DateTime           @default(now()) @map("created_at")
    updatedAt     DateTime           @updatedAt @map("updated_at")
    user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    transactions  Transaction[]

    @@index([isActive, nextRunDate], map: "idx_recurring_rules_active_next_run")
    @@map("recurring_rules")
}

model Budget {
    id                Int      @id @default(autoincrement())
    userId            String   @map("user_id") @db.Char(36)
    categoryId        Int      @map("category_id")
    month             DateTime @db.Date
    limitAmount       Decimal  @map("limit_amount") @db.Decimal(14, 2)
    alertThresholdPct Int      @default(80) @map("alert_threshold_pct") @db.TinyInt
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")
    user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

    @@unique([userId, categoryId, month], map: "uq_budgets_user_category_month")
    @@index([userId, month], map: "idx_budgets_user_month")
    @@map("budgets")
}

model Notification {
    id        BigInt           @id @default(autoincrement())
    userId    String           @map("user_id") @db.Char(36)
    type      NotificationType
    title     String           @db.VarChar(150)
    body      String           @db.VarChar(500)
    payload   Json?
    dedupeKey String?          @map("dedupe_key") @db.VarChar(160)
    readAt    DateTime?        @map("read_at")
    createdAt DateTime         @default(now()) @map("created_at")
    updatedAt DateTime         @updatedAt @map("updated_at")
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, dedupeKey], map: "uq_notifications_user_dedupe_key")
    @@index([userId, readAt, createdAt], map: "idx_notifications_user_read_created")
    @@map("notifications")
}

model ImportBatch {
    id               String            @id @db.Char(36)
    userId           String            @map("user_id") @db.Char(36)
    originalFilename String            @map("original_filename") @db.VarChar(255)
    fileSha256       String            @map("file_sha256") @db.Char(64)
    status           ImportBatchStatus
    totalRows        Int               @default(0) @map("total_rows")
    validRows        Int               @default(0) @map("valid_rows")
    committedRows    Int               @default(0) @map("committed_rows")
    errorReport      Json?             @map("error_report")
    committedAt      DateTime?         @map("committed_at")
    createdAt        DateTime          @default(now()) @map("created_at")
    updatedAt        DateTime          @updatedAt @map("updated_at")
    user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions     Transaction[]
    rows             ImportRow[]

    @@unique([userId, fileSha256], map: "uq_import_batches_user_sha256")
    @@index([status, updatedAt], map: "idx_import_batches_status_updated_at")
    @@map("import_batches")
}

model ImportRow {
    id            BigInt           @id @default(autoincrement())
    importBatchId String           @map("import_batch_id") @db.Char(36)
    rowNumber     Int              @map("row_number")
    dateRaw       String?          @map("date_raw") @db.VarChar(100)
    amountRaw     String?          @map("amount_raw") @db.VarChar(100)
    typeRaw       String?          @map("type_raw") @db.VarChar(32)
    description   String?          @db.VarChar(255)
    categoryRaw   String?          @map("category_raw") @db.VarChar(120)
    txnDate       DateTime?        @map("txn_date") @db.Date
    amount        Decimal?         @db.Decimal(14, 2)
    type          TransactionType?
    merchantKey   String?          @map("merchant_key") @db.VarChar(100)
    categoryId    Int?             @map("category_id")
    selected      Boolean          @default(true)
    isDuplicate   Boolean          @default(false) @map("is_duplicate")
    errors        Json?
    createdAt     DateTime         @default(now()) @map("created_at")
    updatedAt     DateTime         @updatedAt @map("updated_at")
    importBatch   ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
    category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

    @@index([importBatchId, rowNumber], map: "idx_import_rows_batch_row")
    @@index([importBatchId, selected], map: "idx_import_rows_batch_selected")
    @@map("import_rows")
}

model IdempotencyKey {
    id        BigInt   @id @default(autoincrement())
    userId    String?  @map("user_id") @db.Char(36)
    scope     String   @db.VarChar(80)
    keyHash   String   @unique @map("key_hash") @db.Char(64)
    createdAt DateTime @default(now()) @map("created_at")
    expiresAt DateTime @map("expires_at")
    user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([expiresAt], map: "idx_idempotency_keys_expires_at")
    @@map("idempotency_keys")
}

model TransactionHistory {
    id            BigInt                   @id @default(autoincrement())
    transactionId String                   @map("transaction_id") @db.Char(36)
    userId        String?                  @map("user_id") @db.Char(36)
    action        TransactionHistoryAction
    snapshot      Json
    changedFields Json?                    @map("changed_fields")
    changedBy     String                   @map("changed_by") @db.Char(36)
    changedAt     DateTime                 @map("changed_at")
    createdAt     DateTime                 @default(now()) @map("created_at")
    transaction   Transaction              @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([transactionId, changedAt], map: "idx_transaction_history_transaction_changed_at")
    @@map("transaction_history")
}

model AiCategoryRule {
    id                   BigInt   @id @default(autoincrement())
    userId               String   @map("user_id") @db.Char(36)
    merchantKey          String   @map("merchant_key") @db.VarChar(100)
    categoryId           Int      @map("category_id")
    hitCount             Int      @default(1) @map("hit_count") @db.UnsignedInt
    consecutiveOverrides Int      @default(0) @map("consecutive_overrides") @db.UnsignedSmallInt
    lastUsedAt           DateTime @default(now()) @map("last_used_at")
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@unique([userId, merchantKey], map: "uq_ai_category_rules_user_merchant")
    @@map("ai_category_rules")
}

model AiUsageDaily {
    userId    String   @map("user_id") @db.Char(36)
    usageDate DateTime @map("usage_date") @db.Date
    callCount Int      @default(0) @map("call_count") @db.UnsignedInt
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, usageDate])
    @@map("ai_usage_daily")
}
