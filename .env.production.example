# =============================================================================
# .env.production.example – copy to .env.production (repo root):
#   Copy-Item .env.production.example .env.production
# Used by docker-compose.prod.yml BOTH ways: (1) `--env-file .env.production` resolves every
# `${VAR}` in the compose file itself (image tags, build args, required-secret checks), and
# (2) each service's own `env_file: .env.production` injects the same values into the container's
# process env, read by backend/src/config/env.ts. Never commit the real file (already in
# .gitignore's `.env.*` rule). Full walkthrough: docs/deploy.md.
# =============================================================================

# ---- Image tag (set by .github/workflows/deploy.yml to the git SHA; "local" for a manual/dev
# test of this compose file on your own machine, docs/deploy.md "Local Windows test run") --------
IMAGE_TAG=local

# ---- Database (MySQL 8.4) — service name "mysql", not localhost, inside data_net -------------
MYSQL_ROOT_PASSWORD=change-me-root
# CC_APP_PASSWORD/CC_MIGRATOR_PASSWORD are read by database/create_users.prod.sh (the mysql
# container's own init script) to create the cc_app/cc_migrator accounts — they MUST be the exact
# same passwords embedded in DATABASE_URL/DATABASE_MIGRATOR_URL below, or the app/migrator simply
# can't log in. (These only apply the FIRST time the mysql_data volume is created; changing them
# later needs a real `ALTER USER` against the running database, not just an edit here.)
CC_APP_PASSWORD=change-me-app-password
CC_MIGRATOR_PASSWORD=change-me-migrator-password
DATABASE_URL=mysql://cc_app:change-me-app-password@mysql:3306/campus_coin
DATABASE_MIGRATOR_URL=mysql://cc_migrator:change-me-migrator-password@mysql:3306/campus_coin

# ---- Redis — service name "redis" ---------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379

# ---- Application --------------------------------------------------------------------------
NODE_ENV=production
# Public domain (fronted by Cloudflare, docs/deploy.md) — used in email links, CORS, Sentry env.
APP_URL=https://campuscoin.example.com
API_URL=https://campuscoin.example.com/api/v1
CORS_ORIGINS=https://campuscoin.example.com
LOG_LEVEL=info

# ---- Authentication (generate with `npm run keys:generate`, same as dev) -------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_KID=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
IP_HASH_SECRET=replace-me-base64-32-bytes
HIBP_ENABLED=true
# One-time bootstrap of the first real admin account (npm run admin:create -w backend, run once
# by hand after the first deploy — see docs/deploy.md); blank these out again afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Field encryption (AES-256-GCM; generate with `npm run keys:generate`) -----------------
DATA_ENCRYPTION_KEY=replace-me-base64-32-bytes
DATA_ENCRYPTION_KEY_VERSION=1

# ---- Email (a real SMTP relay — Mailpit is dev-only) ---------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusCoin <no-reply@campuscoin.example.com>"
SUPPORT_EMAIL=

# ---- AI (a separate, low-quota key for staging is recommended, docs/spec/10 §11.1) ---------
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=3000
AI_DAILY_QUOTA=200

# ---- Monitoring ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=production

# ---- Privacy & data lifecycle ---------------------------------------------------------------
AUDIT_ARCHIVE_DIR=backups/audit

# ---- Frontend build args (baked into the SPA bundle at `docker compose build` time — NOT
# secrets, docs/spec/10 §11.3) ------------------------------------------------------------------
VITE_API_URL=
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
VITE_SENTRY_DSN=

# ---- Backup (infra/backup/backup.sh — cron on the VPS host, docs/spec/09 §9.13) ---------------
# age recipient public key (`age-keygen`, run once on the VPS; keep the private key OFFLINE,
# never on the VPS itself, or a compromised VPS could decrypt its own backups).
BACKUP_AGE_RECIPIENT=age1replacemewiththerealpublickey
# S3-compatible bucket in a DIFFERENT region/provider than the VPS (docs/spec/09 §9.13 "khác
# vùng"), configured as an rclone remote named "backup" on the host (docs/deploy.md), e.g.
# `rclone config` → type s3 → name it exactly "backup".
BACKUP_S3_REMOTE=backup
BACKUP_S3_BUCKET=campuscoin-backups
# Where backup.sh/restore.sh send a failure alert (either or both; blank = that channel is skipped).
BACKUP_ALERT_EMAIL=
BACKUP_ALERT_WEBHOOK_URL=
