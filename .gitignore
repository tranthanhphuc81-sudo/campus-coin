# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment files (secrets) – only .env.example / .env.production.example are committed
.env
.env.*
!.env.example
!.env.production.example

# Test output
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Logs & OS / editor junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Prisma client (generated by `npm run db:generate`, also on install/typecheck/test)
backend/src/generated/

# Local archive output of the cleanup.expired job (P16: archived audit-log .jsonl.gz files)
backups/

# P20: local self-signed TLS certs (scripts/generate-dev-certs.mjs) — never commit; the directory
# itself is, so the bind mount in docker-compose.prod.yml has somewhere to point before the first
# `npm run certs:dev`. (.env.production is already covered by the `.env.*` rule above.)
infra/certs/*
!infra/certs/.gitkeep

# P20: maintenance-mode toggle file (`touch` this to take the site down, `rm` to restore) —
# an operator action on the running host, never something committed to the repo.
infra/nginx/maintenance-control/*
!infra/nginx/maintenance-control/.gitkeep

# P21: generated submission package (npm run package:submission) — a build artefact, never
# committed; recreated on demand right before hand-off.
submission/
