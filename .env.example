# Runtime mode (development | test | production)
NODE_ENV=

# API server port
PORT=

# Frontend application URL (used in links and CORS)
APP_URL=

# Comma-separated allowed CORS origins
CORS_ORIGINS=

# Primary MySQL connection string for Prisma Client
DATABASE_URL=

# MySQL connection string used by Prisma Migrate
MIGRATE_DATABASE_URL=

# JWT keypair and key id (Ed25519)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
JWT_SECRET=

# Access/refresh token settings
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Secret used to hash IP for audit logs
IP_HASH_SECRET=

# SMTP transport configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI provider configuration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=
AI_DAILY_QUOTA=

# Observability
SENTRY_DSN=