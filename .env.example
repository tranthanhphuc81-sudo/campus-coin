# =============================================================================
# .env.example – copy to .env and fill in:   Copy-Item .env.example .env
# Every variable from docs/spec/10 §11.3. Values here are DEV placeholders only.
# Secrets (JWT keys, DATA_ENCRYPTION_KEY, IP_HASH_SECRET): run `npm run keys:generate`
# and paste its output over the placeholders below. Never commit .env.
# =============================================================================

# ---- Docker (dev compose) ---------------------------------------------------
# Host ports – change if MySQL/XAMPP or another Redis already uses them on Windows.
# If you change them, update the ports in DATABASE_URL / DATABASE_MIGRATOR_URL / REDIS_URL too.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me-redis

# ---- Application ------------------------------------------------------------
NODE_ENV=development
# Dev ports. The Vite dev server fails (strictPort) instead of jumping to another port.
# If you change them, update APP_URL / API_URL / CORS_ORIGINS below to match.
API_PORT=3000
WEB_PORT=5174
# Public URL of the SPA (used in email links) and of the API.
APP_URL=http://localhost:5174
API_URL=http://localhost:3000
# Comma-separated allowlist of browser origins (must include APP_URL).
CORS_ORIGINS=http://localhost:5174
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---- Database (MySQL 8.4) ---------------------------------------------------
# Users/passwords are created by database/create_users.sql (dev-only passwords).
# Runtime account (SELECT/INSERT/UPDATE/DELETE only):
DATABASE_URL=mysql://cc_app:cc_app_dev_password@localhost:3306/campus_coin
# Migration account (ALL on the schema), used by Prisma migrate:
DATABASE_MIGRATOR_URL=mysql://cc_migrator:cc_migrator_dev_password@localhost:3306/campus_coin

# ---- Redis ------------------------------------------------------------------
# Password must equal REDIS_PASSWORD above.
REDIS_URL=redis://:change-me-redis@localhost:6379

# ---- Authentication ---------------------------------------------------------
# Ed25519 key pair in PEM, one line with \n escapes (from npm run keys:generate).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_KID=replace-me
# Access token 15 min (admin 10 min is enforced in code), refresh token lifetime.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Secret for HMAC-hashing client IPs in logs/audit (base64, 32 bytes).
IP_HASH_SECRET=replace-me-base64-32-bytes
# Check new/changed passwords against HaveIBeenPwned (k-anonymity range API). true|false.
HIBP_ENABLED=true
# Optional: bootstrap the first admin account (used only by the P02 seed script).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Field encryption (AES-256-GCM) -----------------------------------------
# 32 random bytes, base64. Bump the version when rotating the key.
DATA_ENCRYPTION_KEY=replace-me-base64-32-bytes
DATA_ENCRYPTION_KEY_VERSION=1

# ---- Email (dev: Mailpit, inbox at http://localhost:8025) -------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusCoin <no-reply@campuscoin.local>"
# Shown in the account-deletion email ("contact support within 30 days to cancel"). Optional —
# defaults to MAIL_FROM's own address.
SUPPORT_EMAIL=

# ---- AI (leave AI_API_KEY empty to run tier 1+2 only — rule/keyword fallback, NullProvider) --
# gemini | openai
AI_PROVIDER=gemini
# Empty = NullProvider (tier 3/LLM disabled; tiers 1-2 always work). AI_MODEL is required once
# this is set.
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=3000
# Max LLM provider CALLS per user per local day (D3: one batch call, however many items, is 1).
AI_DAILY_QUOTA=200

# ---- Monitoring (optional) --------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development

# ---- Privacy & data lifecycle -------------------------------------------------
# Directory the cleanup.expired job writes archived (>12mo) audit-log .jsonl.gz files to.
AUDIT_ARCHIVE_DIR=backups/audit

# ---- Frontend (exposed to the browser at build time – NO secrets here) -------
# Empty = same origin (dev uses the Vite /api proxy).
VITE_API_URL=
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
VITE_SENTRY_DSN=
